# Copy to .env.claude-providers.local and fill only the providers you use.
# Local files matching .env.*.local stay ignored.

# Default selection used when --provider / --model are omitted.
CLAUDE_PROVIDER=openrouter
CLAUDE_MODEL=nex-agi/nex-n2-pro:free

# OpenRouter profile.
# Get a key from: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_DEFAULT_MODEL=nex-agi/nex-n2-pro:free
OPENROUTER_MODELS=nex-agi/nex-n2-pro:free,anthropic/claude-sonnet-4,openai/gpt-5.2,google/gemini-2.5-pro

# Z.ai profile.
# Fill only if you want to use: ./claude-provider.sh --provider zai
ZAI_AUTH_TOKEN=
ZAI_BASE_URL=https://api.z.ai/api/anthropic
ZAI_DEFAULT_MODEL=glm-5.1
ZAI_MODELS=glm-5.1,glm-4.5-air

# Custom profile. Used with --provider custom.
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_API_KEY=
# ANTHROPIC_DEFAULT_HAIKU_MODEL=
# ANTHROPIC_DEFAULT_SONNET_MODEL=
# ANTHROPIC_DEFAULT_OPUS_MODEL=
